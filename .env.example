DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
AUTH_JWT_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_EVIDENCE_BUCKET="YOUR_PRIVATE_EVIDENCE_BUCKET"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="YOUR_SMTP_USER"
SMTP_PASSWORD="YOUR_SMTP_PASSWORD"
SMTP_FROM="alertas@example.com"
ALERT_SCHEDULER_ENABLED="true"
# Opcional si las herramientas PostgreSQL no están en PATH.
# PG_BIN="C:\\Program Files\\PostgreSQL\\18\\bin"
