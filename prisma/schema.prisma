generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model acciones_mitigacion {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan_id           String            @db.Uuid
  descripcion       String            @db.VarChar(500)
  responsable_id    String            @db.Uuid
  fecha_limite      DateTime          @db.Date
  avance            Decimal           @default(0) @db.Decimal(5, 2)
  estado            estado_plan       @default(activo)
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?         @db.Timestamptz(6)
  planes_mitigacion planes_mitigacion @relation(fields: [plan_id], references: [id], onUpdate: NoAction)
  usuarios          usuarios          @relation(fields: [responsable_id], references: [id], onUpdate: NoAction)
  alertas           alertas[]
  evidencias        evidencias[]

  @@index([fecha_limite, estado], map: "idx_acciones_vencimiento", where: raw("(deleted_at IS NULL)"))
  @@index([plan_id, fecha_limite], map: "idx_acciones_plan", where: raw("(deleted_at IS NULL)"))
}

