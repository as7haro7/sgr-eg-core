  usuarios                  usuarios                   @relation(fields: [destinatario_id], references: [id], onUpdate: NoAction)
  evaluaciones_cumplimiento evaluaciones_cumplimiento? @relation(fields: [evaluacion_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  hallazgos                 hallazgos?                 @relation(fields: [hallazgo_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  normativas                normativas?                @relation(fields: [normativa_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  planes_mitigacion         planes_mitigacion?         @relation(fields: [plan_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  reglas_alerta             reglas_alerta              @relation(fields: [regla_codigo], references: [codigo], onUpdate: NoAction)
  requisitos                requisitos?                @relation(fields: [requisito_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  riesgos                   riesgos?                   @relation(fields: [riesgo_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([destinatario_id, estado, severidad, generada_at], map: "idx_alertas_bandeja")
